{
  "name": "iam-demo-apps",
  "version": "0.1.0",
  "private": false,
  "description": "A gallery of fictional business applications that sign in for real against the Lyam IAM POC (OpenID Connect or SAML 2.0).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "express": "4.21.2",
    "openid-client": "6.8.9",
    "samlify": "2.15.1"
  },
  "devDependencies": {
    "oidc-provider": "9.13.3",
    "playwright-core": "1.49.1"
  }
}
